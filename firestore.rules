rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Shared Collections ──

    // users/{uid} — Core profile shared across all Quizy apps
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      // users/{uid}/friends/{friendUid}
      match /friends/{friendUid} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }

      // users/{uid}/notifications/{notificationId}
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }
    }

    // usernames/{username} — Username to UID mapping
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
    }

    // ── Arena-Specific Collections ──

    // arena_profiles/{uid} — Arena game profile
    match /arena_profiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    // arena_sessions/{sessionId} — Game session logs
    match /arena_sessions/{sessionId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // arena_games/{gameId} — Game catalog (read-only)
    match /arena_games/{gameId} {
      allow read: if isAuthenticated();
    }

    // arena_worlds/{worldId} — World catalog (read-only)
    match /arena_worlds/{worldId} {
      allow read: if isAuthenticated();
    }

    // arena_matches/{matchId} — Multiplayer matches
    match /arena_matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants;
    }

    // arena_leaderboards/{boardId} — Leaderboards (read-only)
    match /arena_leaderboards/{boardId} {
      allow read: if isAuthenticated();
    }

    // arena_seasons/{seasonId} — Season catalog (read-only)
    match /arena_seasons/{seasonId} {
      allow read: if isAuthenticated();
    }

    // arena_season_progress/{progressId} — Season progress
    match /arena_season_progress/{progressId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // arena_missions/{missionId} — Mission catalog (read-only)
    match /arena_missions/{missionId} {
      allow read: if isAuthenticated();
    }

    // arena_mission_progress/{progressId} — Mission progress
    match /arena_mission_progress/{progressId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // arena_chests/{chestId} — Treasure chests
    match /arena_chests/{chestId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // arena_stars/{starId} — Star records
    match /arena_stars/{starId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // achievements_catalog/{id} — Achievement catalog (read-only)
    match /achievements_catalog/{id} {
      allow read: if isAuthenticated();
    }

    // user_achievements/{id} — User achievement progress
    match /user_achievements/{id} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
